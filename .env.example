# Copy this file to .env and fill in your values
# API key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Workspace ID (only needed for org-level/admin API keys)
# Find it in the Anthropic Console URL: console.anthropic.com/workspaces/<this-id>
ANTHROPIC_WORKSPACE_ID=

# Neo4j knowledge graph (run: docker-compose up -d  OR use AuraDB free tier)
# AuraDB URI format: neo4j+s://xxxx.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=swimple123
